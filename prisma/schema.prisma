datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Landlord {
  id            String   @id @default(cuid())
  firebaseUid   String   @unique
  name          String
  email         String   @unique
  phone         String?
  stripeId      String?
  plan          String   @default("trial")
  trialEndsAt   DateTime?
  timezone      String   @default("America/Chicago")
  stripeConnectId     String?
  stripeConnectReady  Boolean  @default(false)
  feePassthrough      Boolean  @default(false)
  notifyOnPayment          Boolean  @default(true)
  notifyOnMaintenance      Boolean  @default(true)
  notifyOnOverdue          Boolean  @default(true)
  notifyOnLeaseExpiring    Boolean  @default(true)
  notifyOnInsuranceExpiring Boolean @default(true)
  notifyOnSignature        Boolean  @default(true)
  defaultLateFeeEnabled Boolean @default(false)
  defaultLateFeeType    String  @default("flat")
  defaultLateFeeAmount  Float   @default(50)
  defaultLateFeeGraceDays Int   @default(5)
  showEmailToTenants    Boolean @default(false)
  showPhoneToTenants    Boolean @default(false)
  createdAt     DateTime @default(now())

  properties    Property[]
  expenses      Expense[]
  documents     Document[]
  vendors       Vendor[]
}

model Property {
  id            String   @id @default(cuid())
  landlordId    String
  nickname      String
  address       String
  address2      String?
  city          String
  state         String
  zip           String
  propertyType  String   @default("single_family")
  yearBuilt     Int?
  squareFeet    Int?
  photoUrl      String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  landlord      Landlord @relation(fields: [landlordId], references: [id])
  units         Unit[]
  expenses      Expense[]
  documents     Document[]
}

model Unit {
  id            String   @id @default(cuid())
  propertyId    String
  unitNumber    String   @default("1")
  bedrooms      Int      @default(1)
  bathrooms     Float    @default(1)
  squareFeet    Int?
  notes         String?
  isActive      Boolean  @default(true)
  utilitiesIncluded String[]
  utilitiesNote String?
  property      Property @relation(fields: [propertyId], references: [id])
  leases        Lease[]
  maintenanceRequests MaintenanceRequest[]
}

model Tenant {
  id            String   @id @default(cuid())
  landlordId    String
  name          String
  email         String?
  phone         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes         String?
  portalToken   String?
  isActive      Boolean  @default(true)
  insuranceProvider    String?
  insurancePolicyNumber String?
  insuranceExpiresAt   DateTime?
  createdAt     DateTime @default(now())

  leases        LeaseTenant[]
  maintenanceRequests MaintenanceRequest[]
  rentPayments  RentPayment[]
  leaseSignatures LeaseSignature[]
  leaseMessages   LeaseMessage[]
  addendumSignatures AddendumSignature[]
}

model Lease {
  id              String   @id @default(cuid())
  unitId          String
  landlordId      String
  startDate       DateTime
  endDate         DateTime?
  leaseType       String   @default("fixed")
  monthlyRent     Float
  securityDeposit         Float    @default(0)
  securityDepositPaid     Boolean  @default(false)
  securityDepositPaidAt   DateTime?
  securityDepositHeld     Float    @default(0)
  securityDepositReturnedAt DateTime?
  lateFeeEnabled  Boolean  @default(false)
  lateFeeType     String   @default("flat")
  lateFeeAmount   Float    @default(0)
  lateFeeGracePeriodDays Int @default(5)
  rentDueDay      Int      @default(1)
  petsAllowed     Boolean  @default(false)
  petDeposit      Float    @default(0)
  petRent         Float    @default(0)
  status          String   @default("active")
  terminatedAt    DateTime?
  terminationReason String?
  notes           String?
  createdAt       DateTime @default(now())

  unit            Unit     @relation(fields: [unitId], references: [id])
  tenants         LeaseTenant[]
  rentPayments    RentPayment[]
  documents       Document[]
  maintenanceRequests MaintenanceRequest[]
  signatures      LeaseSignature[]
  depositDeductions DepositDeduction[]
  evictionRecords EvictionRecord[]
  messages        LeaseMessage[]
  inspectionReports InspectionReport[]
  addendums       LeaseAddendum[]
}

model LeaseTenant {
  id        String @id @default(cuid())
  leaseId   String
  tenantId  String
  isPrimary Boolean @default(false)
  lease     Lease  @relation(fields: [leaseId], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  @@unique([leaseId, tenantId])
}

model RentPayment {
  id              String   @id @default(cuid())
  leaseId         String
  tenantId        String?
  landlordId      String
  amount          Float
  lateFee         Float    @default(0)
  lateFeeApplied  Boolean  @default(false)
  totalAmount     Float
  paymentMethod   String   @default("online")
  status          String   @default("pending")
  periodMonth     Int
  periodYear      Int
  paidAt          DateTime?
  dueDate         DateTime
  stripePaymentId String?
  stripePaymentUrl String?
  notes           String?
  receiptSent     Boolean  @default(false)
  createdAt       DateTime @default(now())

  lease           Lease    @relation(fields: [leaseId], references: [id])
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
}

model MaintenanceRequest {
  id              String   @id @default(cuid())
  unitId          String
  leaseId         String?
  tenantId        String?
  landlordId      String
  title           String
  description     String
  category        String   @default("other")
  priority        String   @default("normal")
  status          String   @default("open")
  scheduledFor    DateTime?
  vendorId        String?
  vendorName      String?
  vendorPhone     String?
  estimatedCost   Float?
  actualCost      Float?
  submittedAt     DateTime @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  photoUrls       String[]
  resolvedPhotoUrls String[]
  lastUpdateSentAt DateTime?

  unit            Unit     @relation(fields: [unitId], references: [id])
  lease           Lease?   @relation(fields: [leaseId], references: [id])
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  comments        MaintenanceComment[]
}

model MaintenanceComment {
  id                   String   @id @default(cuid())
  maintenanceRequestId String
  landlordId           String
  body                 String
  attachmentUrl        String?
  attachmentName       String?
  createdAt            DateTime @default(now())

  request MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
}

model Expense {
  id            String   @id @default(cuid())
  landlordId    String
  propertyId    String?
  category      String
  description   String
  amount        Float
  date          DateTime
  vendor        String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  landlord      Landlord @relation(fields: [landlordId], references: [id])
  property      Property? @relation(fields: [propertyId], references: [id])
}

model LeaseSignature {
  id         String    @id @default(cuid())
  leaseId    String
  tenantId   String
  token      String    @unique
  status     String    @default("pending")
  signerName String?
  signerIp   String?
  signedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  lease  Lease  @relation(fields: [leaseId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model EvictionRecord {
  id         String   @id @default(cuid())
  leaseId    String
  landlordId String
  type       String
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id])
}

model DepositDeduction {
  id          String   @id @default(cuid())
  leaseId     String
  description String
  amount      Float
  createdAt   DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id])
}

model Vendor {
  id         String   @id @default(cuid())
  landlordId String
  name       String
  trade      String   @default("general")
  phone      String?
  email      String?
  website    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  landlord            Landlord             @relation(fields: [landlordId], references: [id])
  maintenanceRequests MaintenanceRequest[]
}

model Document {
  id            String   @id @default(cuid())
  landlordId    String
  propertyId    String?
  leaseId       String?
  name          String
  docType       String   @default("other")
  fileUrl       String
  fileType      String?
  notes         String?
  uploadedAt    DateTime @default(now())
  landlord      Landlord @relation(fields: [landlordId], references: [id])
  property      Property? @relation(fields: [propertyId], references: [id])
  lease         Lease?   @relation(fields: [leaseId], references: [id])
}

model LeaseMessage {
  id         String   @id @default(cuid())
  leaseId    String
  landlordId String
  tenantId   String?
  senderRole String   // "landlord" | "tenant"
  body       String
  createdAt  DateTime @default(now())

  lease  Lease   @relation(fields: [leaseId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

model InspectionReport {
  id         String   @id @default(cuid())
  leaseId    String
  landlordId String
  type       String   // "move_in" | "move_out"
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())

  lease Lease            @relation(fields: [leaseId], references: [id])
  items InspectionItem[]
}

model InspectionItem {
  id                 String  @id @default(cuid())
  inspectionReportId String
  room               String
  condition          String  // "good" | "fair" | "poor"
  notes              String?

  report InspectionReport @relation(fields: [inspectionReportId], references: [id], onDelete: Cascade)
}

model LeaseAddendum {
  id         String   @id @default(cuid())
  leaseId    String
  landlordId String
  title      String
  body       String
  createdAt  DateTime @default(now())

  lease      Lease               @relation(fields: [leaseId], references: [id])
  signatures AddendumSignature[]
}

model AddendumSignature {
  id         String    @id @default(cuid())
  addendumId String
  tenantId   String
  token      String    @unique
  status     String    @default("pending")
  signerName String?
  signedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  addendum LeaseAddendum @relation(fields: [addendumId], references: [id])
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
}
